# Configuração do serviço NA MIRA. Copie para um arquivo privado no servidor.
# O Python NÃO carrega .env automaticamente: use EnvironmentFile do systemd
# ou injete/exporte essas variáveis antes de iniciar o processo.

PENTEST_ORCHESTRATOR=v2
# Estes dois flags aceitam 1/true/on/yes; NÃO use "enabled".
PENTEST_CVE_INTELLIGENCE=1
PENTEST_AI_PLANNING=1

PENTEST_CONTAINER_EXECUTION=enabled
PENTEST_LABORATORY=enabled
PENTEST_LABORATORY_INPROCESS=0
PENTEST_INDEPENDENT_VALIDATION=enabled
PENTEST_MITRE_ATTACK=enabled
PENTEST_CAPTURE_RETENTION_DAYS=7
PENTEST_AUTO_APPROVE_QUOTED_SEARCH=0

# Bedrock: preencha o token real SOMENTE no ambiente privado do servidor,
# ou use as credenciais/role AWS já disponíveis. Não é uma AWS Access Key ID.
PENTEST_AI_PROVIDER=bedrock
PENTEST_BEDROCK_MODEL=amazon.nova-micro-v1:0
PENTEST_BEDROCK_REGION=us-east-1
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
PENTEST_AI_PLANNING_PROVIDER=bedrock
PENTEST_REFLECTION_PROVIDER=bedrock

# Alternativa OpenAI: troque também os três selectors de provider acima.
# OPENAI_API_KEY=
# PENTEST_AI_MODEL=ID_DO_MODELO_DISPONIVEL

# Para o seed offline, sobrescreva SOMENTE no processo do seed:
# PENTEST_AI_PLANNING=0 PENTEST_AI_PLANNING_PROVIDER= PENTEST_REFLECTION_PROVIDER=
# O serviço de produção continua com a configuração de IA acima.
